// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  firstName       String?
  lastName        String?
  avatar          String?
  role            String   @default("USER")
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resume          Resume?
  roadmap         Roadmap?
  studySessions   StudySession[]
  questionAttempts QuestionAttempt[]
}

model Resume {
  id               String   @id @default(cuid())

  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  originalFileName String
  storedFileName   String

  mimeType         String
  fileSize         Int

  pageCount        Int?

  extractedText    String?

  name             String?
  email            String?
  phone            String?

  skills           String?
  education        String?
  experience       String?
  projects         String?

  aiSummary        String?
  strengths        String?
  weaknesses       String?
  suggestedSkills  String?
  analysisVersion  String?
  analyzedAt       DateTime?

  status           String   @default("UPLOADED")

  parseVersion     String?
  parseStatus      String?
  parseError       String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Roadmap {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  targetRole     String
  currentLevel   String
  estimatedWeeks Int
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  modules        RoadmapModule[]
  studySessions  StudySession[]
}

model RoadmapModule {
  id             String         @id @default(cuid())
  roadmapId      String
  roadmap        Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  order          Int
  category       String
  title          String
  description    String
  estimatedHours Int
  difficulty     String         @default("Beginner")
  status         String         @default("PENDING")
  topics         RoadmapTopic[]
  studySessions  StudySession[]
}

model RoadmapTopic {
  id               String        @id @default(cuid())
  moduleId         String
  module           RoadmapModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order            Int
  title            String
  description      String
  estimatedMinutes Int
  status           String        @default("PENDING")
  masteryPercentage Int          @default(0)
  studyTasks       StudyTask[]
  questionAttempts QuestionAttempt[]
}

model StudySession {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId          String
  roadmap            Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  currentModuleId    String
  currentModule      RoadmapModule @relation(fields: [currentModuleId], references: [id], onDelete: Cascade)
  sessionDate        DateTime      @default(now())
  estimatedMinutes   Int           @default(0)
  totalQuestions     Int           @default(0)
  completedQuestions Int           @default(0)
  status             String        @default("PENDING")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tasks              StudyTask[]
  questionAttempts   QuestionAttempt[]
}

model StudyTask {
  id               String       @id @default(cuid())
  sessionId        String
  session          StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topicId          String
  topic            RoadmapTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  order            Int
  title            String
  estimatedMinutes Int
  status           String       @default("PENDING")
  questionAttempts QuestionAttempt[]
}

model QuestionAttempt {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySessionId   String
  session          StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  studyTaskId      String
  task             StudyTask    @relation(fields: [studyTaskId], references: [id], onDelete: Cascade)
  topicId          String
  topic            RoadmapTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  question         String
  questionType     String?
  difficulty       String       @default("Beginner")
  userAnswer       String?
  
  overallScore     Int?
  technicalScore   Int?
  problemSolvingScore Int?
  communicationScore  Int?
  timeComplexityScore Int?
  spaceComplexityScore Int?
  confidenceScore  Int?
  
  feedback         String?
  strengths        String?
  mistakes         String?
  missingConcepts  String?
  correctAnswer    String?
  optimizedAnswer  String?
  resources        String?
  followUpQuestions String?
  
  evaluationJson   String?
  evaluationModel  String?
  tokensUsed       Int?
  timeTaken        Int?
  evaluatedAt      DateTime?
  
  status           String       @default("PENDING") // PENDING, SKIPPED, SUBMITTED
  
  startedAt        DateTime     @default(now())
  submittedAt      DateTime?
  
  createdAt        DateTime     @default(now())
}